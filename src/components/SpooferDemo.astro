    border-bottom: 1px solid var(--color-line);
    padding: 0.85rem 0;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }

  .spoof-toggle {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-muted);
    padding: 0.15rem 0.65rem 0.15rem 0.3rem;
    font: inherit;
    font-size: 0.72rem;
    font-weight: 560;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .spoof-toggle[aria-checked='true'] {
    border-color: rgba(212, 196, 255, 0.7);
