<aside class="panel spoof-demo px-5 py-4 sm:px-6" aria-label="One-click spoofer preview">
  <p class="spoof-title">One-click spoofer</p>
  <div class="spoof-row">
    <span id="tpm-name">TPM Bypasser</span>
    <button
      type="button"
      class="spoof-toggle"
      role="switch"
      aria-checked="false"
      aria-labelledby="tpm-name tpm-state"
      data-spoof="tpm"
    >
      <span class="spoof-track" aria-hidden="true"><span class="spoof-thumb"></span></span>
      <span id="tpm-state" data-state>Off</span>
    </button>
  </div>
  <div class="spoof-row">
    <span id="mac-name">MAC Address Changer</span>
    <button
      type="button"
      class="spoof-toggle"
      role="switch"
      aria-checked="false"
      aria-labelledby="mac-name mac-state"
      data-spoof="mac"
    >
      <span class="spoof-track" aria-hidden="true"><span class="spoof-thumb"></span></span>
      <span id="mac-state" data-state>Off</span>
    </button>
  </div>
  <div class="spoof-mac">
    <p>Current MAC</p>
    <p class="spoof-mac-value" data-mac aria-live="polite">XX:XX:XX:XX:XX:XX</p>
  </div>
</aside>

<script is:inline>
  const demo = document.querySelector('.spoof-demo');
  if (demo) {
    const macValue = demo.querySelector('[data-mac]');
    const placeholder = 'XX:XX:XX:XX:XX:XX';

    function randomMac() {
      const bytes = new Uint8Array(6);
      crypto.getRandomValues(bytes);
      bytes[0] = (bytes[0] & 0xfe) | 0x02;
      return Array.from(bytes, (byte) => byte.toString(16).padStart(2, '0'))
        .join(':')
        .toUpperCase();
    }

    function setSwitch(button, on) {
      button.setAttribute('aria-checked', on ? 'true' : 'false');
      const state = button.querySelector('[data-state]');
      if (state) state.textContent = on ? 'On' : 'Off';
    }

    demo.querySelectorAll('[data-spoof]').forEach((button) => {
      button.addEventListener('click', () => {
        const on = button.getAttribute('aria-checked') !== 'true';
        setSwitch(button, on);
        if (button.getAttribute('data-spoof') !== 'mac' || !macValue) return;
        macValue.textContent = on ? randomMac() : placeholder;
        macValue.classList.toggle('is-live', on);
      });
    });
  }
</script>

