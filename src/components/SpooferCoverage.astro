---
import { coverageGroups, coverageFaqs } from '../data/coverage';

interface Props {
  gameName: string;
}

const { gameName } = Astro.props;
---

<section class="mt-14" aria-labelledby="coverage-heading">
  <p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Spoofer coverage</p>
  <h2 id="coverage-heading" class="mt-3 text-4xl">{gameName} spoofer coverage</h2>
  <div class="mt-8 grid gap-4 lg:grid-cols-3">
    {
      coverageGroups.map((group) => (
        <div class="panel p-5">
          <h3 class="text-2xl">{group.title}</h3>
          <ul class="mt-4 space-y-2 text-muted">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<section class="mt-14" aria-labelledby="coverage-faq-heading">
  <h2 id="coverage-faq-heading" class="text-4xl">Questions about the {gameName} spoofer</h2>
  <div class="mt-6 divide-y divide-line border-y border-line">
    {
      coverageFaqs.map((faq) => (
        <article id={faq.id} class="py-6">
          <h3 class="text-2xl">{faq.question}</h3>
          <p class="mt-3 max-w-3xl text-muted">{faq.answer}</p>
        </article>
      ))
    }
  </div>
</section>
