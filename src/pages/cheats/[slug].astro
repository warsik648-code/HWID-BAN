---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CheatBuy from '../../components/CheatBuy.astro';
import { cheats, type Cheat } from '../../data/cheats';

export function getStaticPaths() {
  return cheats.map((cheat) => ({
    params: { slug: cheat.slug },
    props: { cheat },
  }));
}

interface Props {
  cheat: Cheat;
}

const { cheat } = Astro.props;
const path = `/cheats/${cheat.slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Cheats', path: '/cheats' },
  { name: cheat.name, path },
];
const description = `${cheat.name} cheats for PC with ${cheat.features.join(' and ')}. Status: undetected. This page lists the product and opens Buy Now.`;
const hwidPath =
  {
    valorant: '/games/valorant',
    fortnite: '/games/fortnite',
    rust: '/games/rust',
    warzone: '/games/call-of-duty-warzone',
  }[cheat.slug] ?? null;
---

<BaseLayout title={`${cheat.name} Cheats`} description={description} path={path} breadcrumbs={crumbs}>
  <article class="shell py-12 sm:py-16">
    <Breadcrumbs items={crumbs} />
    <div class="cheat-detail">
      <img
        src={cheat.image}
        alt={cheat.imageAlt}
        width="460"
        height="215"
        decoding="async"
      />
      <div>
        <p class="text-xs font-medium tracking-[0.18em] text-accent uppercase">Cheats</p>
        <h1 class="mt-3 text-5xl">{cheat.name} Cheats</h1>
        <p class="mt-4 text-xl text-muted">{cheat.description}</p>
        <p class="cheat-status">Status: Undetected</p>
        <ul>
          {cheat.features.map((feature) => <li>{feature}</li>)}
        </ul>
        <CheatBuy url={cheat.affiliateUrl} />
        <p class="mt-6">
          <a class="text-accent" href="/cheats">All cheats</a>
        </p>
        {
          hwidPath && (
            <p class="mt-4 max-w-xl text-muted">
              If a new account is still blocked on the same PC, that is a{' '}
              <a class="text-accent" href={hwidPath}>
                {cheat.name} HWID ban
              </a>
              .
            </p>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .cheat-detail {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .cheat-detail img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 460 / 215;
    object-fit: cover;
    border: 1px solid rgba(167, 139, 250, 0.2);
    border-radius: 1rem;
    background: #100c18;
  }

  .cheat-status {
    margin: 1rem 0 0;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 560;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cheat-detail ul {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
  }

  .cheat-detail :global(.btn) {
    margin-top: 1.25rem;
  }

  .cheat-detail :global(.btn:disabled) {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media (min-width: 64rem) {
    .cheat-detail {
      grid-template-columns: minmax(0, 1.15fr) minmax(16rem, 0.85fr);
      align-items: center;
    }
  }
</style>
